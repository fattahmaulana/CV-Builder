# ==============================================================================
# CVBuilder Environment Variables Example
# Semua secret HANYA boleh diakses dari server (Server Components, Route Handlers, Server Actions)
# ==============================================================================

# Aplikasi
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRICE_IDR=5000

# Supabase Auth & Database (RLS wajib aktif)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-do-not-expose

# Google Gemini API
# Model utama dan fallback untuk menjaga uptime saat kuota limit
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# SociaBuzz QRIS Payment Gateway
SOCIABUZZ_BASE_URL=https://sociabuzz.com
SOCIABUZZ_USERNAME=your-sociabuzz-username
SOCIABUZZ_API_KEY=your-sociabuzz-api-key

# DOKU Checkout Payment Gateway (Fallback)
DOKU_CLIENT_ID=your-doku-client-id
DOKU_SECRET_KEY=your-doku-secret-key
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_NOTIFICATION_URL=http://localhost:3000/api/payments/webhook

# Google OAuth & Google Sheets API (Scope drive.file)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Kunci Enkripsi (AES-256-GCM 32-byte hex string untuk token Google & data sensitif)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Upstash Redis (Rate limit & Antrean AI)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Sentry Monitoring (Haram mengirim data CV / PII)
NEXT_PUBLIC_SENTRY_DSN=
